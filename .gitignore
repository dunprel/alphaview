yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
.next/
out/
build/
*.tsbuildinfo

# ─── Environment files ───────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
