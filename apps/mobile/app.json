{
  "expo": {
    "name":        "AlphaView TV",
    "slug":        "alphaview-tv",
    "version":     "1.0.0",
    "orientation": "portrait",
    "icon":        "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image":           "./assets/splash.png",
      "resizeMode":      "contain",
      "backgroundColor": "#080510"
    },
    "backgroundColor": "#080510",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet":          true,
      "bundleIdentifier":        "tv.alphaview.app",
      "buildNumber":             "1",
      "infoPlist": {
        "NSCameraUsageDescription":             "AlphaView uses the camera for profile photos.",
        "NSPhotoLibraryUsageDescription":       "AlphaView uses your photos for profile pictures.",
        "NSPhotoLibraryAddUsageDescription":    "AlphaView saves downloaded thumbnails to your library.",
        "UIBackgroundModes":                    ["audio"],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "alphaview.tv": { "NSExceptionAllowsInsecureHTTPLoads": false }
          }
        }
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.tv.alphaview"]
      }
    },
    "android": {
      "package":         "tv.alphaview.app",
      "versionCode":     1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080510"
      },
      "permissions": [
        "INTERNET",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-screen-capture",
        { "preventScreenCapture": true }
      ],
      [
        "@react-native-firebase/app",
        {
          "android": { "googleServicesFile": "./google-services.json" },
          "ios":     { "googleServicesFile": "./GoogleService-Info.plist" }
        }
      ]
    ],
    "scheme": "alphaview",
    "extra": {
      "eas": { "projectId": "YOUR_EAS_PROJECT_ID" },
      "apiUrl":            "https://api.alphaview.tv/v1",
      "cdnUrl":            "https://cdn.alphaview.tv",
      "paystackPublicKey": "pk_live_YOUR_KEY"
    }
  }
}
